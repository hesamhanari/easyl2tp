#!/bin/bash
# ezl2tp — TUI/CLI panel for an easyl2tp L2TP + IKEv2 server
# Built on top of the easyl2tp installer, it does NOT replace it.
# It only reads/writes through the existing data files and, for
# add/del/stats/reset/logs, delegates to /usr/local/bin/l2tp-user
# so ipsec.secrets rebuilding stays in one place.
#
# Installed by install.sh. To install by hand, as root:
#   cp ezl2tp /usr/local/bin/ezl2tp
#   chmod +x /usr/local/bin/ezl2tp
#   ezl2tp
#
# Interactive menu:   ezl2tp
#   1 Status  2 User Management  3 Live sessions  4 Logs  5 Restart services
#   6 Backup  7 Check For Updates  8 Uninstall  0 Exit
#   User Management = Show all users (numbered; pick one for its own menu)
#   and Add user. Everything per-user lives there.
# One-shot commands:  ezl2tp status | users | stats | live | logs
#                     ezl2tp add <user> [password]
#                     ezl2tp del <user>
#                     ezl2tp card <user>
#                     ezl2tp limit <user> <GB>      (data limit, e.g. 50 or 12.5)
#                     ezl2tp limit <user> clear     (unlimited)
#                     ezl2tp restart
#                     ezl2tp backup | backups | update
#
# Data sources (overridable with EZL2TP_* env vars, for testing only):
#   chap-secrets, ipsec.secrets, l2tp-secrets,
#   /var/log/vpn-usage/totals.db, /var/log/vpn-usage/sessions.log,
#   /run/vpn-sessions/*
# Also test-only: EZL2TP_ROOT (prefix for the backup / uninstall paths),
#   EZL2TP_BACKUP_ROOT, EZL2TP_VERSION_FILE, EZL2TP_RUN_DIR, EZL2TP_COLOR,
#   EZL2TP_ALLOW_NONROOT, EZL2TP_RESTART_WAIT.
#
# Usage and online status (users, status, the menu header) come from
# "l2tp-user usage": totals.db PLUS the live counters of open sessions
# (ppp interface counters for L2TP, iptables IKEV2_UP_/IKEV2_DOWN_ counters
# for IKEv2), with online status taken from /run/vpn-sessions/*. The same
# rows feed "l2tp-user stats", so the two can never disagree. If l2tp-user
# is an older copy without that command, the panel falls back to the saved
# totals plus the session files (no live bytes) and never calls it.
#
# Data limits are kept and enforced by l2tp-user ("l2tp-user limits" rows:
# limit, used, period, BLOCKED state). The panel only shows them and passes
# "ezl2tp limit" on, so the panel and the CLI always agree. A user with no
# limit shows as "unlimited" and is never blocked.

set -u

CHAP="${EZL2TP_CHAP:-/etc/ppp/chap-secrets}"
IPSEC_SECRETS="${EZL2TP_IPSEC_SECRETS:-/etc/ipsec.secrets}"
L2TP_SECRETS="${EZL2TP_L2TP_SECRETS:-/etc/xl2tpd/l2tp-secrets}"
TOTALS_DB="${EZL2TP_TOTALS_DB:-/var/log/vpn-usage/totals.db}"
SESSIONS_LOG="${EZL2TP_SESSIONS_LOG:-/var/log/vpn-usage/sessions.log}"
SESSIONS_DIR="${EZL2TP_SESSIONS_DIR:-/run/vpn-sessions}"
L2TP_USER="${EZL2TP_L2TP_USER:-/usr/local/bin/l2tp-user}"
RUN_DIR="${EZL2TP_RUN_DIR:-/run}"

# Backup / update / uninstall. EZL2TP_ROOT is a path prefix so the tests can
# work on a fake filesystem; it is empty on a real server.
ROOTFS="${EZL2TP_ROOT:-}"
BACKUP_ROOT="${EZL2TP_BACKUP_ROOT:-/root}"
BACKUP_MARK=".easyl2tp-backup"
VERSION_FILE="${EZL2TP_VERSION_FILE:-/var/lib/easyl2tp/version}"
UPDATE_REPO="${EZL2TP_REPO:-hesamhanari/easyl2tp}"
UPDATE_BRANCH="${EASYL2TP_BRANCH:-main}"
RESTART_WAIT="${EZL2TP_RESTART_WAIT:-2}"

# Colors: on a terminal, or when EZL2TP_COLOR=always; EZL2TP_COLOR=never turns
# them off. C_BOLD/C_YELLOW/C_CYAN are reserved for menu polish.
case "${EZL2TP_COLOR:-auto}" in
  always) use_color=1 ;;
  never) use_color=0 ;;
  *) if [ -t 1 ]; then use_color=1; else use_color=0; fi ;;
esac
# shellcheck disable=SC2034
if [ "$use_color" = 1 ]; then
  C_BOLD='\033[1m'; C_GREEN='\033[32m'; C_RED='\033[31m'
  C_YELLOW='\033[33m'; C_CYAN='\033[36m'; C_RESET='\033[0m'
else
  C_BOLD=''; C_GREEN=''; C_RED=''; C_YELLOW=''; C_CYAN=''; C_RESET=''
fi

SERVER_IP_CACHE=""

human() {
  awk -v x="${1:-0}" 'BEGIN {
    split("B KB MB GB TB", u, " "); s = 1
    while (x >= 1024 && s < 5) { x /= 1024; s++ }
    printf "%.2f %s", x, u[s]
  }'
}

is_ipv4() {
  case "$1" in
    ''|*[!0-9.]* ) return 1 ;;
  esac
  printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
}

server_ip() {
  if [ -n "$SERVER_IP_CACHE" ]; then printf '%s' "$SERVER_IP_CACHE"; return; fi
  local ip="" cand=""
  if command -v curl >/dev/null 2>&1; then
    # -4 on purpose: the modem/phone need the IPv4 address, not IPv6.
    # Validate the result: some ifconfig.me paths return an IPv6
    # address even with -4 (proxy environments), so fall through
    # to the next source if it is not IPv4.
    cand="$(curl -4 -s --max-time 3 ifconfig.me 2>/dev/null || true)"
    if is_ipv4 "$cand"; then ip="$cand"; fi
    if [ -z "$ip" ]; then
      cand="$(curl -4 -s --max-time 3 https://api.ipify.org 2>/dev/null || true)"
      if is_ipv4 "$cand"; then ip="$cand"; fi
    fi
  fi
  if [ -z "$ip" ]; then
    ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -m1 -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true)"
  fi
  SERVER_IP_CACHE="${ip:-unknown}"
  printf '%s' "$SERVER_IP_CACHE"
}

master_psk() {
  awk -F'"' '/^: PSK/ {print $2; exit}' "$IPSEC_SECRETS" 2>/dev/null || true
}

tun_pass() {
  awk '{print $3; exit}' "$L2TP_SECRETS" 2>/dev/null || true
}

# One name per line, sorted the same way as "l2tp-user stats" (C locale), so a
# user keeps the same number in the menu even after their password is changed
# (which moves their line to the end of chap-secrets).
list_users() {
  [ -f "$CHAP" ] || return 0
  awk '!/^#/ && NF >= 3 { gsub(/"/, "", $1); if ($1 != "") print $1 }' "$CHAP" 2>/dev/null | LC_ALL=C sort -u
}

user_pass() {
  local want="$1"
  [ -f "$CHAP" ] || return 0
  awk -v u="$want" '{ gsub(/"/, ""); if ($1 == u) { print $3; exit } }' "$CHAP" 2>/dev/null
}

# Rows "<user> <upload> <download> <sessions>" from "l2tp-user usage".
USAGE_ROWS=""
USAGE_LIVE=0

# Rows "<user> <limit> <used> <start> <end> <state> <sessions>" from
# "l2tp-user limits": one per user that HAS a limit (state: pending, ok,
# BLOCKED, expired). Users without a row are unlimited.
LIMIT_ROWS=""

# Older l2tp-user copies treat any unknown word as a NEW USERNAME to add, so
# "usage" and "limit" are only sent to a copy that carries these marker lines.
l2tp_user_has_usage() {
  [ -x "$L2TP_USER" ] && grep -q '^# easyl2tp-api: usage-v1$' "$L2TP_USER" 2>/dev/null
}
l2tp_user_has_limits() {
  [ -x "$L2TP_USER" ] && grep -q '^# easyl2tp-api: limits-v1$' "$L2TP_USER" 2>/dev/null
}

# Refresh the rows. Call at the start of every screen that shows usage.
load_usage() {
  USAGE_ROWS=""
  USAGE_LIVE=0
  LIMIT_ROWS=""
  if l2tp_user_has_usage && USAGE_ROWS="$("$L2TP_USER" usage 2>/dev/null)"; then
    USAGE_LIVE=1
  else
    USAGE_ROWS=""
  fi
  if l2tp_user_has_limits; then
    LIMIT_ROWS="$("$L2TP_USER" limits 2>/dev/null || true)"
  fi
}

# Prints the limit row of one user, or nothing when the user is unlimited.
user_limit_row() {
  printf '%s\n' "$LIMIT_ROWS" | awk -v u="$1" '$1 == u { print; exit }'
}

# Epoch seconds -> date (UTC); with $2 = time, date and time.
fmt_epoch() {
  if [ "${2:-}" = time ]; then
    date -u -d "@$1" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "-"
  else
    date -u -d "@$1" '+%Y-%m-%d' 2>/dev/null || echo "-"
  fi
}

# One line: used / limit / left / period of a limited user, prefixed by $1.
# Prints nothing for an unlimited user.
describe_limit() {
  local ind="$1" row lim used end state left
  row="$(user_limit_row "$2")"
  [ -n "$row" ] || return 0
  read -r _ lim used _ end state _ <<EOF
$row
EOF
  left=$((lim - used)); [ "$left" -lt 0 ] && left=0
  case "$state" in
    pending)
      printf '%sused %s of %s, left %s - the 30-day period starts at the first connection\n' "$ind" "$(human "$used")" "$(human "$lim")" "$(human "$left")" ;;
    expired)
      printf '%sused %s of %s - period ended %s, the next connection starts a fresh one\n' "$ind" "$(human "$used")" "$(human "$lim")" "$(fmt_epoch "$end")" ;;
    BLOCKED)
      printf '%sBLOCKED: used %s of %s, left %s - blocked until the period ends %s\n' "$ind" "$(human "$used")" "$(human "$lim")" "$(human "$left")" "$(fmt_epoch "$end" time)" ;;
    *)
      printf '%sused %s of %s, left %s, period ends %s\n' "$ind" "$(human "$used")" "$(human "$lim")" "$(human "$left")" "$(fmt_epoch "$end" time)" ;;
  esac
}

user_totals() {
  local want="$1" rx=0 tx=0
  if [ -f "$TOTALS_DB" ]; then
    read -r rx tx <<EOF
$(awk -v u="$want" '$1 == u {print $2, $3; exit}' "$TOTALS_DB" 2>/dev/null)
EOF
  fi
  printf '%s %s' "${rx:-0}" "${tx:-0}"
}

# Prints "<upload> <download> <sessions>" for one user, sessions "-" if offline.
user_usage() {
  local want="$1" rx tx sess
  if [ "$USAGE_LIVE" = 1 ]; then
    read -r rx tx sess <<EOF
$(printf '%s\n' "$USAGE_ROWS" | awk -v u="$want" '$1 == u { print $2, $3, $4; exit }')
EOF
  else
    # Older l2tp-user: saved totals plus session files, no live bytes.
    read -r rx tx <<EOF
$(user_totals "$want")
EOF
    sess="$(user_sessions "$want" | awk '{ printf "%s%s", (n++ ? "," : ""), $1 }')"
  fi
  printf '%s %s %s' "${rx:-0}" "${tx:-0}" "${sess:--}"
}

# Prints one line per live session for a user: "ppp3 <peer IP>" etc.
user_sessions() {
  local want="$1" f u peer
  [ -d "$SESSIONS_DIR" ] || return 0
  for f in "$SESSIONS_DIR"/*; do
    [ -f "$f" ] || continue
    read -r u peer < "$f" 2>/dev/null || continue
    u="$(printf '%s' "$u" | tr -d '"')"
    if [ "$u" = "$want" ]; then
      printf '%s %s\n' "$(basename "$f")" "${peer:-}"
    fi
  done
}

count_users() { list_users | wc -l | tr -d ' '; }

count_online() {
  local n=0
  if [ "$USAGE_LIVE" = 1 ]; then
    n="$(printf '%s\n' "$USAGE_ROWS" | awk '$4 != "" && $4 != "-" { n++ } END { print n + 0 }')"
  elif [ -d "$SESSIONS_DIR" ]; then
    # Count distinct users with a live session file, not files.
    n="$(awk '{ gsub(/"/, "", $1); if ($1 != "") print $1 }' "$SESSIONS_DIR"/* 2>/dev/null | sort -u | wc -l | tr -d ' ')"
  fi
  printf '%s' "${n:-0}"
}

total_traffic() {
  if [ "$USAGE_LIVE" = 1 ]; then
    printf '%s\n' "$USAGE_ROWS" | awk '{ r += $2; t += $3 } END { printf "%.0f %.0f", r, t }'
  elif [ -f "$TOTALS_DB" ]; then
    awk '{ r += $2; t += $3 } END { printf "%s %s", r + 0, t + 0 }' "$TOTALS_DB" 2>/dev/null
  else
    printf '0 0'
  fi
}

svc() {
  local s
  # is-active exits non-zero when a service is inactive, so do NOT
  # use "|| echo unknown" here — it would append a second line.
  s="$(systemctl is-active "$1" 2>/dev/null || true)"
  [ -z "$s" ] && s="unknown"
  if [ "$s" = "active" ]; then
    printf '%b%s%b' "$C_GREEN" "active" "$C_RESET"
  else
    printf '%b%s%b' "$C_RED" "$s" "$C_RESET"
  fi
}

show_status() {
  local kernel ppp users online rx tx
  load_usage
  kernel="$(uname -r 2>/dev/null || echo unknown)"
  if [ -e /dev/ppp ]; then ppp="${C_GREEN}yes${C_RESET}"; else ppp="${C_RED}no${C_RESET}"; fi
  users="$(count_users)"; online="$(count_online)"
  read -r rx tx <<EOF
$(total_traffic)
EOF
  echo "=================================================="
  echo "  ezl2tp — Status"
  echo "=================================================="
  printf "Server:          %s\n" "$(server_ip)"
  printf "Kernel:          %s\n" "$kernel"
  printf "PPP device:      %b\n" "$ppp"
  printf "strongswan:      %b\n" "$(svc strongswan-starter)"
  printf "xl2tpd:          %b\n" "$(svc xl2tpd)"
  printf "l2tp-firewall:   %b\n" "$(svc l2tp-firewall)"
  echo "--------------------------------------------------"
  if command -v ss >/dev/null 2>&1; then
    local udp=""
    udp="$(ss -uln 2>/dev/null | grep -E ':(500|4500|1701) ' || true)"
    if [ -n "$udp" ]; then
      printf '%s\n' "$udp" | sed 's/^/UDP listen:      /'
    else
      echo "UDP listen:      (no 500/4500/1701 found)"
    fi
  fi
  echo "--------------------------------------------------"
  printf "Users:           %s total, %s online\n" "$users" "$online"
  printf "Total traffic:   upload %s, download %s\n" "$(human "$rx")" "$(human "$tx")"
  echo "=================================================="
}

# Users of the last show_users call, in table order: row N = USERS_LIST[N-1].
USERS_LIST=()

# Fills USERS_LIST from list_users.
load_users_list() {
  local u
  USERS_LIST=()
  while IFS= read -r u; do
    [ -n "$u" ] && USERS_LIST+=("$u")
  done <<EOF
$(list_users)
EOF
  return 0
}

# One table, one row per user: usage, limit, limit-period end and status. Rows
# come from the same "l2tp-user usage" rows as "l2tp-user stats" and the status
# screen (totals.db plus the live counters of open sessions), so they cannot
# disagree. "numbered" adds a # column for the menu. The whole row has one
# colour: green = ONLINE, yellow = BLOCKED (over the limit, even if still
# connected), red = offline. EXPIRE is the end of the limit period
# (YYYY-MM-DD HH:MM UTC); "-" for an unlimited user or a period not started.
# Width: 93 columns, 98 with the # column, so it fits a 100-column terminal.
show_users() {
  local numbered="${1:-}" u rx tx sess status lrow lstate lim lend lcol expire color prefix hdr rule n=0
  load_usage
  load_users_list
  if [ -n "$numbered" ]; then hdr="  #  "; rule=98; else hdr=""; rule=93; fi
  printf '%*s\n' "$rule" "" | tr ' ' '='
  printf "%s%-16s %-8s %-11s %-11s %-11s %-10s %-20s\n" "$hdr" "USERNAME" "STATUS" "UPLOAD" "DOWNLOAD" "TOTAL" "LIMIT" "EXPIRE"
  printf '%*s\n' "$rule" "" | tr ' ' '-'
  if [ "${#USERS_LIST[@]}" -eq 0 ]; then echo "No users yet."; fi
  for u in "${USERS_LIST[@]+"${USERS_LIST[@]}"}"; do
    n=$((n + 1))
    read -r rx tx sess <<EOF
$(user_usage "$u")
EOF
    if [ "$sess" != "-" ]; then status="ONLINE"; color="$C_GREEN"; else status="offline"; color="$C_RED"; fi
    lrow="$(user_limit_row "$u")"
    lcol="unlimited"
    expire="-"
    if [ -n "$lrow" ]; then
      read -r _ lim _ _ lend lstate _ <<EOF
$lrow
EOF
      lcol="$(human "$lim")"
      # A pending period has no start and no end yet: nothing to show.
      if [ "$lstate" != "pending" ] && [ "${lend:-0}" -gt 0 ]; then expire="$(fmt_epoch "$lend" time)"; fi
      if [ "$lstate" = "BLOCKED" ]; then status="BLOCKED"; color="$C_YELLOW"; fi
    fi
    prefix=""
    if [ -n "$numbered" ]; then prefix="$(printf '%3s  ' "$n")"; fi
    printf "%b%s%-16s %-8s %-11s %-11s %-11s %-10s %-20s%b\n" "$color" "$prefix" "$u" "$status" "$(human "$rx")" "$(human "$tx")" "$(human $((rx + tx)))" "$lcol" "$expire" "$C_RESET"
  done
  printf '%*s\n' "$rule" "" | tr ' ' '='
  echo "(Passwords are NOT shown here. Use 'card <user>' for one user's card.)"
  echo "(LIMIT: 'ezl2tp limit <user> <GB>' sets one, 'ezl2tp limit <user> clear' removes it.)"
}

show_live() {
  local f u peer
  echo "=================================================="
  echo "  Live sessions"
  echo "=================================================="
  if [ ! -d "$SESSIONS_DIR" ] || [ -z "$(ls -A "$SESSIONS_DIR" 2>/dev/null)" ]; then
    echo "No live sessions."
    echo "=================================================="
    return 0
  fi
  printf "%-18s %-16s %-18s\n" "SESSION" "USER" "PEER / IP"
  echo "--------------------------------------------------"
  for f in "$SESSIONS_DIR"/*; do
    [ -f "$f" ] || continue
    read -r u peer < "$f" 2>/dev/null || continue
    printf "%-18s %-16s %-18s\n" "$(basename "$f")" "$(printf '%s' "$u" | tr -d '"')" "${peer:-}"
  done
  echo "=================================================="
}

show_stats() {
  if [ -x "$L2TP_USER" ]; then
    "$L2TP_USER" stats
  else
    echo "l2tp-user not found at $L2TP_USER — showing totals only:"
    show_users
  fi
}

show_logs() {
  if [ -x "$L2TP_USER" ]; then
    "$L2TP_USER" logs
  elif [ -f "$SESSIONS_LOG" ]; then
    tail -n 50 "$SESSIONS_LOG"
  else
    echo "No session log found at $SESSIONS_LOG"
  fi
}

require_l2tp_user() {
  if [ ! -x "$L2TP_USER" ]; then
    echo "ERROR: $L2TP_USER not found or not executable."
    echo "Run the easyl2tp install.sh first, then retry."
    return 1
  fi
  return 0
}

# Reads one line into REPLY_VAL. End of input (the SSH session dropped, or a
# script ran out of answers) ends the panel instead of looping on empty
# answers. Call it directly, never inside $( ).
ask() {
  printf '%s' "$1"
  IFS= read -r REPLY_VAL || { echo; echo "Bye."; exit 0; }
}

# Prints the prompt and succeeds only for exactly YES (no spaces, any other
# answer or end of input cancels).
confirm_yes() {
  local ans
  printf '%s' "$1"
  IFS= read -r ans || ans=""
  [ "$ans" = "YES" ]
}

user_exists() { [ -n "$(user_pass "$1")" ]; }

random_secret() { openssl rand -hex 6 2>/dev/null || echo changeme; }

do_add() {
  local user="$1" pass="$2"
  require_l2tp_user || return 1
  if user_exists "$user"; then
    echo "User '$user' already exists. Delete it first, or pick another name."
    return 1
  fi
  "$L2TP_USER" add "$user" "$pass"
}

do_del() {
  local user="$1"
  require_l2tp_user || return 1
  if ! confirm_yes "Delete user '$user'? This cannot be undone. Type YES to confirm: "; then echo "Cancelled."; return 0; fi
  "$L2TP_USER" del "$user"
}

# Data-limit answer -> "clear" (0 or the word clear = unlimited) or the number
# of GB; the empty answer gives $2 (the default). Returns 1 for anything else.
# The number rule is the one l2tp-user applies.
parse_limit_answer() {
  local a="${1:-}" def="${2:-}"
  a="$(printf '%s' "$a" | tr '[:upper:]' '[:lower:]')"
  [ -z "$a" ] && a="$def"
  if [ "$a" = "clear" ]; then echo clear; return 0; fi
  if ! printf '%s' "$a" | grep -Eq '^[0-9]{1,7}(\.[0-9]{1,6})?$'; then return 1; fi
  if awk -v v="$a" 'BEGIN { exit !(v + 0 == 0) }'; then echo clear; else echo "$a"; fi
}

# "Add user": name, password (or random), data limit in GB, then the card.
# The limit is checked before the user is created, so a bad answer or an old
# l2tp-user that cannot do limits creates nothing.
add_user_flow() {
  local nu np nl limit add_out
  require_l2tp_user || return 1
  ask "New username: "; nu="$REPLY_VAL"
  if ! printf '%s' "$nu" | grep -Eq '^[A-Za-z0-9._-]{1,32}$'; then
    echo "Invalid username: use 1-32 characters of A-Z a-z 0-9 . _ - (no spaces or quotes)."
    return 1
  fi
  if user_exists "$nu"; then
    echo "User '$nu' already exists. Delete it first, or pick another name."
    return 1
  fi
  # read without -s on purpose: over SSH from a phone a hidden prompt is easy
  # to mistype with no feedback.
  ask "Password (Enter = random): "; np="$REPLY_VAL"
  if [ -z "$np" ]; then
    np="$(random_secret)"
  elif ! printf '%s' "$np" | grep -Eq '^[A-Za-z0-9._-]{6,64}$'; then
    echo "Invalid password: use 6-64 characters of A-Z a-z 0-9 . _ - (no spaces or quotes)."
    return 1
  fi
  ask "Data limit in GB (Enter = 1 GB, 0 or clear = unlimited): "; nl="$REPLY_VAL"
  if ! limit="$(parse_limit_answer "$nl" 1)"; then
    echo "Invalid limit '$nl': give a number of GB such as 1 or 12.5, 0, or the word clear."
    return 1
  fi
  if [ "$limit" != "clear" ] && ! l2tp_user_has_limits; then
    echo "ERROR: the installed $L2TP_USER does not know data limits yet, so no user was added."
    echo "Update it by running the easyl2tp install.sh again (your users are kept)."
    return 1
  fi
  if ! add_out="$("$L2TP_USER" add "$nu" "$np" 2>&1)"; then
    printf '%s\n' "$add_out"
    return 1
  fi
  echo "User '$nu' created."
  if [ "$limit" != "clear" ]; then
    if ! do_limit "$nu" "$limit"; then
      echo "The user exists but has NO limit. Set one with: ezl2tp limit $nu <GB>"
    fi
  else
    echo "No data limit: $nu is unlimited."
  fi
  show_card "$nu"
}

# Change a user's password: l2tp-user add replaces the user's chap-secrets,
# pap-secrets and ipsec.secrets lines. Their limit and usage are not touched.
change_password() {
  local user="$1" np pw_out
  require_l2tp_user || return 1
  ask "New password for $user (Enter = random): "; np="$REPLY_VAL"
  if [ -z "$np" ]; then
    np="$(random_secret)"
  elif ! printf '%s' "$np" | grep -Eq '^[A-Za-z0-9._-]{6,64}$'; then
    echo "Invalid password: use 6-64 characters of A-Z a-z 0-9 . _ - (no spaces or quotes)."
    return 1
  fi
  if ! pw_out="$("$L2TP_USER" add "$user" "$np" 2>&1)"; then
    printf '%s\n' "$pw_out"
    return 1
  fi
  echo "Password changed for $user. Their data limit and usage are unchanged."
  echo "A session that is connected now keeps working until it reconnects."
  show_card "$user"
}

# Set / clear one user's data limit. 0 or "clear" = unlimited.
set_limit_flow() {
  local user="$1" nl limit cur
  load_usage
  cur="$(describe_limit "" "$user")"
  if [ -n "$cur" ]; then echo "Now: $cur"; else echo "Now: unlimited"; fi
  ask "Limit for $user in GB (50 or 12.5; 0 or clear = unlimited; Enter = cancel): "; nl="$REPLY_VAL"
  if [ -z "$nl" ]; then echo "Cancelled."; return 0; fi
  if ! limit="$(parse_limit_answer "$nl")"; then
    echo "Invalid limit '$nl': give a number of GB such as 50 or 12.5, 0, or the word clear."
    return 1
  fi
  do_limit "$user" "$limit"
}

# Zero the usage of one user (and restart their limit period). The limit stays.
reset_data() {
  local user="$1"
  require_l2tp_user || return 1
  if ! confirm_yes "Reset the data usage of '$user' to zero? Type YES to confirm: "; then echo "Cancelled."; return 0; fi
  "$L2TP_USER" reset "$user"
}

# End one pppd, the way the limit check does: only a real pppd, found through
# its pid file.
kill_ppp() {
  local pidfile="$RUN_DIR/$1.pid" pid=""
  [ -r "$pidfile" ] || return 1
  read -r pid < "$pidfile" || true
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "pppd" ] || return 1
  kill "$pid" 2>/dev/null
}

# SA ids of the IKEv2 sessions of one user, from "ipsec statusall".
ikev2_sa_ids() {
  ipsec statusall 2>/dev/null | awk -v u="$1" '
    /ikev2-psk\[[0-9]+\]: ESTABLISHED/ {
      line = $0
      if (!match(line, /ikev2-psk\[[0-9]+\]/)) next
      id = substr(line, RSTART + 10, RLENGTH - 11)
      cur = ""
      if (match(line, /\.\.\.[^ ]+\[[^]]+\]/)) {
        cur = substr(line, RSTART, RLENGTH)
        sub(/^.*\[/, "", cur); sub(/\]$/, "", cur); gsub(/"/, "", cur)
      }
      if (cur == u) print id
    }'
}

# Disconnect now: end every live session of the user. They can reconnect at
# once; this blocks nothing (a data limit does that).
disconnect_now() {
  local user="$1" rx tx sess s dev id ended=0 failed=0
  load_usage
  read -r rx tx sess <<EOF
$(user_usage "$user")
EOF
  if [ "$sess" = "-" ]; then echo "$user is not connected."; return 0; fi
  for s in $(printf '%s' "$sess" | tr ',' ' '); do
    case "$s" in
      "L2TP(ppp"*)
        dev="${s#L2TP(}"; dev="${dev%)}"
        if kill_ppp "$dev"; then echo "Disconnected $s"; ended=$((ended + 1)); else echo "Could not disconnect $s"; failed=$((failed + 1)); fi
        ;;
    esac
  done
  case "$sess" in
    *"IKEv2("*)
      for id in $(ikev2_sa_ids "$user"); do
        if ipsec down "ikev2-psk[$id]" >/dev/null 2>&1; then echo "Disconnected IKEv2 (sa $id)"; ended=$((ended + 1)); else echo "Could not disconnect IKEv2 (sa $id)"; failed=$((failed + 1)); fi
      done
      ;;
  esac
  if [ "$ended" -eq 0 ] && [ "$failed" -eq 0 ]; then echo "No session of $user could be found to disconnect ($sess)."; fi
  echo "$user can reconnect right away. To keep them out, set a data limit or delete the user."
}

# The menu of one user. Returns when the user picks Back or the user is gone.
user_menu() {
  local user="$1" row sess
  while true; do
    if ! user_exists "$user"; then echo "User '$user' no longer exists."; return 0; fi
    load_usage
    [ -t 1 ] && clear 2>/dev/null
    read -r _ _ sess <<EOF
$(user_usage "$user")
EOF
    echo "=================================================="
    echo "  User: $user"
    echo "=================================================="
    if [ "$sess" != "-" ]; then printf "Status: %bONLINE%b (%s)\n" "$C_GREEN" "$C_RESET" "$sess"; else printf "Status: %boffline%b\n" "$C_RED" "$C_RESET"; fi
    row="$(describe_limit "" "$user")"
    if [ -n "$row" ]; then echo "Limit:  $row"; else echo "Limit:  unlimited"; fi
    echo "--------------------------------------------------"
    echo "1 Show card"
    echo "2 Change password"
    echo "3 Set / clear data limit"
    echo "4 Reset data"
    echo "5 Disconnect now"
    echo "6 Delete user"
    echo "0 Back"
    echo "--------------------------------------------------"
    ask "Choice: "
    case "$REPLY_VAL" in
      1) show_card "$user"; pause ;;
      2) change_password "$user"; pause ;;
      3) set_limit_flow "$user"; pause ;;
      4) reset_data "$user"; pause ;;
      5) disconnect_now "$user"; pause ;;
      6) do_del "$user"; pause ;;
      0) return 0 ;;
      *) echo "Invalid choice."; sleep 1 ;;
    esac
  done
}

# User Management > Show all users: the numbered table, then pick a number
# (r = refresh, 0 = back).
show_all_users_menu() {
  local pick
  while true; do
    [ -t 1 ] && clear 2>/dev/null
    show_users numbered
    if [ "${#USERS_LIST[@]}" -eq 0 ]; then pause; return 0; fi
    ask "Select a user number (0 = back, r = refresh): "; pick="$REPLY_VAL"
    case "$pick" in
      0|'') return 0 ;;
      # Refresh: the loop re-runs show_users (fresh totals + live counters,
      # numbers assigned again) and prompts again without leaving the screen.
      r|R) continue ;;
      *[!0-9]*) echo "Invalid choice."; sleep 1; continue ;;
    esac
    if [ "$pick" -lt 1 ] || [ "$pick" -gt "${#USERS_LIST[@]}" ]; then echo "Out of range."; sleep 1; continue; fi
    user_menu "${USERS_LIST[$((pick - 1))]}"
  done
}

user_management_menu() {
  while true; do
    [ -t 1 ] && clear 2>/dev/null
    echo "=================================================="
    echo "  User Management"
    echo "=================================================="
    echo "1 Show all users"
    echo "2 Add user"
    echo "0 Back"
    echo "--------------------------------------------------"
    ask "Choice: "
    case "$REPLY_VAL" in
      1) show_all_users_menu ;;
      2) add_user_flow; pause ;;
      0) return 0 ;;
      *) echo "Invalid choice."; sleep 1 ;;
    esac
  done
}

# The data-limit block of a card: limit, used, remaining, period end, status.
card_limit() {
  local user="$1" row lim used end state left rx tx sess
  row="$(user_limit_row "$user")"
  if [ -z "$row" ]; then
    read -r rx tx sess <<EOF
$(user_usage "$user")
EOF
    printf "Data limit:               unlimited\n"
    printf "Used:                     %s\n" "$(human $((rx + tx)))"
    return 0
  fi
  read -r _ lim used _ end state _ <<EOF
$row
EOF
  left=$((lim - used)); [ "$left" -lt 0 ] && left=0
  printf "Data limit:               %s per 30 days (upload + download)\n" "$(human "$lim")"
  printf "Used:                     %s\n" "$(human "$used")"
  printf "Remaining:                %s\n" "$(human "$left")"
  case "$state" in
    pending) printf "Period:                   starts at the first connection\n" ;;
    expired) printf "Period:                   ended %s, a fresh one starts at the next connection\n" "$(fmt_epoch "$end" time)" ;;
    *) printf "Period ends:              %s\n" "$(fmt_epoch "$end" time)" ;;
  esac
  if [ "$state" = "BLOCKED" ]; then
    printf "Status:                   BLOCKED (over the limit until the period ends)\n"
  else
    printf "Status:                   OK\n"
  fi
}

show_card() {
  local user="$1" pass mp tp
  pass="$(user_pass "$user")"
  if [ -z "$pass" ]; then echo "User '$user' not found in $CHAP"; return 1; fi
  load_usage
  mp="$(master_psk)"; tp="$(tun_pass)"
  echo "=========================================="
  echo "  Card for: $user"
  echo "  (Share ONLY with this user — it contains secrets.)"
  echo "=========================================="
  printf "Server IP:                %s\n" "$(server_ip)"
  printf "Username:                 %s\n" "$user"
  printf "Password:                 %s\n" "$pass"
  echo "------------------------------------------"
  card_limit "$user"
  echo "------------------------------------------"
  echo "Modem — plain L2TP (no IPsec):"
  printf "  LNS address:            %s\n" "$(server_ip)"
  echo "  Hostname:                 modem"
  printf "  Tunnel password:        %s\n" "$tp"
  printf "  PPP username:           %s\n" "$user"
  printf "  PPP password:           %s\n" "$pass"
  echo "  Authentication:           Auto"
  echo "------------------------------------------"
  echo "Phone — L2TP/IPsec (TunnelForge, iPhone L2TP):"
  printf "  Server:                 %s\n" "$(server_ip)"
  printf "  PPP username:           %s\n" "$user"
  printf "  PPP password:           %s\n" "$pass"
  printf "  IPsec PSK (shared):     %s\n" "$mp"
  echo "  L2TP secret:              (blank)"
  echo "------------------------------------------"
  echo "Phone — IKEv2/IPsec PSK (Android built-in):"
  printf "  Server:                 %s\n" "$(server_ip)"
  printf "  Identifier (ID):        %s\n" "$user"
  printf "  PSK (per-user):         %s\n" "$pass"
  echo "=========================================="
}

# ezl2tp limit <user> <GB|clear>: l2tp-user keeps and enforces the limit.
do_limit() {
  local user="$1" val="$2"
  require_l2tp_user || return 1
  if ! l2tp_user_has_limits; then
    echo "ERROR: the installed $L2TP_USER does not know data limits yet."
    echo "Update it by running the easyl2tp install.sh again (your users are kept)."
    return 1
  fi
  "$L2TP_USER" limit "$user" "$val"
}

do_restart() {
  echo "Restarting strongswan-starter, xl2tpd, l2tp-firewall..."
  systemctl restart strongswan-starter xl2tpd l2tp-firewall 2>&1
  sleep "$RESTART_WAIT"
  show_status
}

# ---- Backup -----------------------------------------------------------------
# The set: everything install.sh backs up before it overwrites it (ipsec,
# strongswan, xl2tpd, ppp options, chap/pap secrets, sysctl), plus the panel
# and CLI files, the firewall script, the totals database, the limits database
# and the sessions log. tests/panel-test.sh checks that every file the
# installer backs up is in this list.
backup_set() {
  cat <<'SET'
/etc/ipsec.conf
/etc/ipsec.secrets
/etc/strongswan.conf
/etc/xl2tpd/xl2tpd.conf
/etc/xl2tpd/l2tp-secrets
/etc/ppp/options.xl2tpd
/etc/ppp/chap-secrets
/etc/ppp/pap-secrets
/etc/sysctl.d/99-l2tp.conf
/usr/local/bin/ezl2tp
/usr/local/bin/l2tp-user
/usr/local/sbin/l2tp-fw.sh
/var/log/vpn-usage/totals.db
/var/lib/easyl2tp/limits.db
/var/log/vpn-usage/sessions.log
SET
}

# Makes /root/easyl2tp-backup-YYYYmmdd-HHMMSS (mode 0700, same file paths
# below it as on the server) and prints ONLY its path. Everything else goes to
# stderr; no secret is ever printed. Returns 1 and leaves no half-made backup
# if anything fails.
make_backup() {
  local stamp dest n=1 p src copied=0
  stamp="$(date +%Y%m%d-%H%M%S)"
  dest="$BACKUP_ROOT/easyl2tp-backup-$stamp"
  while [ -e "$dest" ]; do n=$((n + 1)); dest="$BACKUP_ROOT/easyl2tp-backup-$stamp-$n"; done
  if ! ( umask 077; mkdir -p "$BACKUP_ROOT" && mkdir -m 700 "$dest" ) 2>/dev/null; then
    echo "ERROR: could not create a backup folder under $BACKUP_ROOT." >&2
    return 1
  fi
  while IFS= read -r p; do
    src="$ROOTFS$p"
    [ -f "$src" ] || continue
    if ! ( umask 077; mkdir -p "$dest$(dirname "$p")" ) || ! cp -a "$src" "$dest$p" 2>/dev/null; then
      echo "ERROR: could not back up $p." >&2
      rm -rf "$dest"
      return 1
    fi
    copied=$((copied + 1))
  done <<EOF
$(backup_set)
EOF
  if [ "$copied" -eq 0 ]; then
    echo "ERROR: none of the easyl2tp files were found, so there is nothing to back up." >&2
    rm -rf "$dest"
    return 1
  fi
  ( umask 077; : > "$dest/$BACKUP_MARK" )
  chmod 700 "$dest"
  printf '%s\n' "$dest"
}

BACKUP_LIST=()
collect_backups() {
  local d
  BACKUP_LIST=()
  for d in "$BACKUP_ROOT"/easyl2tp-backup-*; do
    [ -d "$d" ] && BACKUP_LIST+=("$d")
  done
  return 0
}

# Numbered list of existing backups. Returns 1 when there are none.
list_backups() {
  local d i=0 files kind
  collect_backups
  if [ "${#BACKUP_LIST[@]}" -eq 0 ]; then echo "No backups yet in $BACKUP_ROOT."; return 1; fi
  for d in "${BACKUP_LIST[@]}"; do
    i=$((i + 1))
    files="$(find "$d" -type f ! -name "$BACKUP_MARK" 2>/dev/null | wc -l | tr -d ' ')"
    if [ -f "$d/$BACKUP_MARK" ]; then kind="$files files"; else kind="$files files, made by the installer: restore by hand"; fi
    printf "%3s  %s  (%s)\n" "$i" "$d" "$kind"
  done
}

do_backup() {
  local path
  if ! path="$(make_backup)"; then return 1; fi
  echo "Backup created: $path"
  echo "It holds your secrets (root-only, mode 0700). Keep it private."
}

# Put the files of one panel backup back (only paths from backup_set, each
# swapped in with a rename so a running ezl2tp/l2tp-user is never half-written).
restore_files() {
  local src="$1" p dst n=0
  while IFS= read -r p; do
    [ -f "$src$p" ] || continue
    dst="$ROOTFS$p"
    mkdir -p "$(dirname "$dst")" || return 1
    if ! cp -a "$src$p" "$dst.ezl2tp-restore" || ! mv -f "$dst.ezl2tp-restore" "$dst"; then
      rm -f "$dst.ezl2tp-restore"
      echo "ERROR: could not restore $p." >&2
      return 1
    fi
    n=$((n + 1))
  done <<EOF
$(backup_set)
EOF
  echo "Restored $n files."
}

do_restore() {
  local pick src pre
  if ! list_backups; then return 0; fi
  ask "Restore which backup number (0 = cancel): "; pick="$REPLY_VAL"
  case "$pick" in
    0|'') echo "Cancelled."; return 0 ;;
    *[!0-9]*) echo "Invalid choice."; return 1 ;;
  esac
  if [ "$pick" -lt 1 ] || [ "$pick" -gt "${#BACKUP_LIST[@]}" ]; then echo "Out of range."; return 1; fi
  src="${BACKUP_LIST[$((pick - 1))]}"
  if [ ! -f "$src/$BACKUP_MARK" ]; then
    echo "$src was made by the installer, which keeps flat copies the panel cannot place by itself."
    echo "Copy the files back by hand if you need them."
    return 1
  fi
  echo "Restoring replaces the config, users, secrets and limits on this server"
  echo "with the ones in $src."
  if ! confirm_yes "Type YES to restore: "; then echo "Cancelled."; return 0; fi
  if ! pre="$(make_backup)"; then echo "Could not back up the current state first, so nothing was changed."; return 1; fi
  echo "Current state saved first: $pre"
  restore_files "$src" || return 1
  do_restart
}

backup_menu() {
  while true; do
    [ -t 1 ] && clear 2>/dev/null
    echo "=================================================="
    echo "  Backup"
    echo "=================================================="
    echo "1 Create backup"
    echo "2 List backups"
    echo "3 Restore backup"
    echo "0 Back"
    echo "--------------------------------------------------"
    ask "Choice: "
    case "$REPLY_VAL" in
      1) do_backup; pause ;;
      2) list_backups; pause ;;
      3) do_restore; pause ;;
      0) return 0 ;;
      *) echo "Invalid choice."; sleep 1 ;;
    esac
  done
}

# ---- Check For Updates ------------------------------------------------------
# install.sh writes the commit it installed to $VERSION_FILE. An install from
# before that file existed has none: that is reported as "not recorded" and
# never as an error.
installed_version() {
  local v=""
  if [ -r "$VERSION_FILE" ]; then read -r v < "$VERSION_FILE" || true; fi
  if printf '%s' "$v" | grep -Eq '^[0-9a-f]{40}$'; then printf '%s' "$v"; fi
}

# The commit at the tip of the branch on GitHub; nothing if it cannot be read
# (no internet, rate limit, or a private repo).
latest_version() {
  local v=""
  v="$(curl -fsSL --max-time 10 -H 'Accept: application/vnd.github.sha' \
    "https://api.github.com/repos/$UPDATE_REPO/commits/$UPDATE_BRANCH" 2>/dev/null || true)"
  if printf '%s' "$v" | grep -Eq '^[0-9a-f]{40}$'; then printf '%s' "$v"; fi
}

# Download install.sh into a private folder and run it. The installer keeps the
# users, the secrets and the limits (see install.sh). It replaces this very
# script, so the caller must exit right after.
run_installer() {
  local commit="$1" dir rc
  dir="$(mktemp -d)" || return 1
  if ! curl -fsSL --max-time 30 "https://raw.githubusercontent.com/$UPDATE_REPO/$UPDATE_BRANCH/install.sh" -o "$dir/install.sh" 2>/dev/null \
    || [ "$(head -n 1 "$dir/install.sh" 2>/dev/null)" != "#!/bin/bash" ] || ! bash -n "$dir/install.sh" 2>/dev/null; then
    rm -rf "$dir"
    echo "Could not download a valid install.sh from GitHub. Nothing was changed."
    return 1
  fi
  UPDATE_RAN=1
  EASYL2TP_COMMIT="$commit" EASYL2TP_BRANCH="$UPDATE_BRANCH" bash "$dir/install.sh"
  rc=$?
  rm -rf "$dir"
  return "$rc"
}

# UPDATE_RAN=1 once the installer was started (the caller then exits: the
# installer replaces this script, and bash must not read on in the old file).
UPDATE_RAN=0
check_updates() {
  local cur latest backup
  UPDATE_RAN=0
  cur="$(installed_version)"
  echo "Installed version: ${cur:-not recorded (installed before version tracking)}"
  latest="$(latest_version)"
  if [ -z "$latest" ]; then
    echo "Latest on $UPDATE_BRANCH:   could not be read from GitHub."
    echo "Check the internet connection and try again (a private repo cannot be read without a login)."
    return 1
  fi
  echo "Latest on $UPDATE_BRANCH:   $latest"
  if [ "$cur" = "$latest" ]; then echo "You are up to date."; return 0; fi
  if [ -z "$cur" ]; then
    echo "An update may be available: this install has no recorded version to compare with."
  else
    echo "An update is available."
  fi
  echo "Updating runs the installer from $UPDATE_BRANCH again. Your users, secrets and"
  echo "limits are kept, and a backup is taken first."
  if ! confirm_yes "Type YES to update now: "; then echo "Cancelled. Nothing was changed."; return 0; fi
  if ! backup="$(make_backup)"; then echo "Could not take a backup first, so nothing was changed."; return 1; fi
  echo "Backup created: $backup"
  if run_installer "$latest"; then
    echo "Update finished. Run ezl2tp again to open the new panel."
  else
    echo "The update did not finish. Your backup is at $backup"
    return 1
  fi
}

# ---- Uninstall --------------------------------------------------------------
# Never deletes a backup. Users, secrets, limits and logs stay on disk too;
# only the services are stopped and the panel and CLI are removed.
UNINSTALLED=0
do_uninstall() {
  local backup s
  UNINSTALLED=0
  echo "UNINSTALL easyl2tp: this stops and disables the VPN services"
  echo "(strongswan-starter, xl2tpd, l2tp-firewall, easyl2tp-limits.timer) and removes"
  echo "the ezl2tp panel and the l2tp-user CLI. VPN users stop working."
  echo "A backup is taken first and is never deleted."
  if ! confirm_yes "Type YES to uninstall: "; then echo "Cancelled. Nothing was changed."; return 0; fi
  if ! backup="$(make_backup)"; then echo "Could not take a backup first, so nothing was removed."; return 1; fi
  echo "Backup created: $backup"
  for s in strongswan-starter xl2tpd l2tp-firewall easyl2tp-limits.timer; do
    systemctl disable --now "$s" >/dev/null 2>&1 || echo "Note: could not stop/disable $s (it may not be installed)."
  done
  rm -f "$ROOTFS/usr/local/bin/ezl2tp" "$ROOTFS/usr/local/bin/l2tp-user"
  UNINSTALLED=1
  echo "Services stopped and disabled; ezl2tp and l2tp-user removed."
  echo "Your backup is kept: $backup"
  echo "Users, secrets, limits and logs were left on disk. Install again with install.sh,"
  echo "then restore from the backup if you need to."
}

pause() {
  printf "\nPress Enter to continue..."
  read -r _dummy || true
}

usage() {
  echo "Usage: ezl2tp [status|users|stats|live|logs|add|del|card|limit|restart|backup|backups|update|help]"
  echo "  No argument: interactive menu."
  echo "  add <user> [password]   (empty password = random)"
  echo "  del <user>   card <user>"
  echo "  limit <user> <GB>       data limit per 30 days, upload + download (50 or 12.5)"
  echo "  limit <user> clear      unlimited"
  echo "  backup                  make a backup under $BACKUP_ROOT and print its path"
  echo "  backups                 list existing backups"
  echo "  update                  compare with $UPDATE_BRANCH and offer to update"
}

# --- non-interactive mode ---
if [ "${1:-}" != "" ]; then
  case "$1" in
    status)  show_status ;;
    users)   show_users ;;
    stats)   show_stats ;;
    live)    show_live ;;
    logs)    show_logs ;;
    restart) do_restart ;;
    backup)  make_backup ;;
    backups) list_backups ;;
    update)
      check_updates
      rc=$?
      exit "$rc"
      ;;
    add)
      if [ -z "${2:-}" ]; then echo "Usage: ezl2tp add <user> [password]"; exit 1; fi
      p="${3:-}"; [ -z "$p" ] && p="$(random_secret)"
      do_add "$2" "$p"
      ;;
    del)
      if [ -z "${2:-}" ]; then echo "Usage: ezl2tp del <user>"; exit 1; fi
      # Non-interactive delete still asks for YES, on purpose.
      do_del "$2"
      ;;
    card)
      if [ -z "${2:-}" ]; then echo "Usage: ezl2tp card <user>"; exit 1; fi
      show_card "$2"
      ;;
    limit)
      if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
        echo "Usage: ezl2tp limit <user> <GB>     (decimals allowed: 50 or 12.5)"
        echo "       ezl2tp limit <user> clear   (unlimited)"
        exit 1
      fi
      do_limit "$2" "$3"
      ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $1"; usage; exit 1 ;;
  esac
  # Propagate the command's own exit code (e.g. card for a missing user).
  exit $?
fi

# --- interactive menu ---
if [ "$(id -u)" != "0" ] && [ -z "${EZL2TP_ALLOW_NONROOT:-}" ]; then
  echo "Run ezl2tp as root."
  exit 1
fi

while true; do
  load_usage
  [ -t 1 ] && clear 2>/dev/null
  echo "=================================================="
  echo "  ezl2tp — L2TP + IKEv2 panel"
  echo "=================================================="
  printf "Server: %s   Kernel: %s   Users: %s, %s online\n" \
    "$(server_ip)" "$(uname -r 2>/dev/null || echo unknown)" "$(count_users)" "$(count_online)"
  echo "--------------------------------------------------"
  echo "1 Status"
  echo "2 User Management"
  echo "3 Live sessions"
  echo "4 Logs"
  echo "5 Restart services"
  echo "6 Backup"
  echo "7 Check For Updates"
  echo "8 Uninstall"
  echo "0 Exit"
  echo "--------------------------------------------------"
  ask "Choice: "
  case "$REPLY_VAL" in
    1) show_status; pause ;;
    2) user_management_menu ;;
    3) show_live; pause ;;
    4) show_logs; pause ;;
    5) do_restart; pause ;;
    6) backup_menu ;;
    7)
      check_updates
      # The installer replaced this script. Never read on in the old file.
      if [ "$UPDATE_RAN" = 1 ]; then exit 0; fi
      pause
      ;;
    8)
      do_uninstall
      # The panel is gone after an uninstall.
      if [ "$UNINSTALLED" = 1 ]; then exit 0; fi
      pause
      ;;
    0) echo "Bye."; exit 0 ;;
    *) echo "Invalid choice."; sleep 1 ;;
  esac
done
